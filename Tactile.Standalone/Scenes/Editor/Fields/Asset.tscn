[gd_scene format=3]

[node name="Asset" type="HBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Preview" type="TextureRect" parent="."]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
size_flags_vertical = 4
expand_mode = 1
stretch_mode = 5

[node name="Text" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Id" type="LineEdit" parent="Text"]
layout_mode = 2
tooltip_text = "요소가 이 이름으로 리소스를 가리킵니다. 바꾸면 쓰는 곳도 함께 바뀝니다."
placeholder_text = "이름"

[node name="Info" type="Label" parent="Text"]
modulate = Color(1, 1, 1, 0.65)
layout_mode = 2
theme_override_font_sizes/font_size = 11
text_overrun_behavior = 3

[node name="Remove" type="Button" parent="."]
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "지우기 (쓰던 요소는 단색으로 돌아갑니다)"
text = "✕"
flat = true
