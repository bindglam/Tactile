[gd_scene format=3]

[node name="List" type="VBoxContainer"]
size_flags_horizontal = 3

[node name="Name" type="Label" parent="."]
layout_mode = 2
mouse_filter = 1

[node name="Indent" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 12

[node name="Box" type="VBoxContainer" parent="Indent"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Items" type="VBoxContainer" parent="Indent/Box"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Add" type="Button" parent="Indent/Box"]
layout_mode = 2
size_flags_horizontal = 0
text = "+ 추가"
