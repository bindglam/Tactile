<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            컴파일에 사용할 Unity 참조 어셈블리 버전.
            가장 오래된 LTS 기준으로 빌드해 두면 이후 버전의 게임에서도 대부분 그대로 동작함.
            특정 버전이 필요하면 `dotnet build -p:UnityVersion=2022.3.62`처럼 바꿔서 빌드.
        -->
        <UnityVersion Condition="'$(UnityVersion)' == ''">2019.4.41</UnityVersion>

        <!-- Unity 2021.2부터 엔진 DLL이 netstandard2.1 기준이므로 그에 맞춤 -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(UnityVersion)', '2021.2'))">netstandard2.1</TargetFramework>

        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- 컴파일 전용. Unity DLL은 게임에 이미 있으므로 출력에 복사하지 않음 -->
        <PackageReference Include="UnityEngine.Modules" Version="$(UnityVersion)" PrivateAssets="all" IncludeAssets="compile" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Tactile.Core\Tactile.Core.csproj" />
    </ItemGroup>

</Project>
